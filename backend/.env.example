# ---- required ----
# long random string; generate with:  openssl rand -hex 24
VAULT_TOKEN=change-me

# ---- AI summary (optional) ----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# ---- email (optional) ----  use a separate Gmail + App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.vault.bot@gmail.com
SMTP_PASSWORD=
MAIL_TO=you@gmail.com
MAX_ATTACH_MB=20

# ---- open-access PDFs for DOI links (optional) ----
UNPAYWALL_EMAIL=you@gmail.com

# set to 0 only for local testing without the external drive
REQUIRE_MARKER=1
